{
  "manifest_version": 3,
  "name": "OCPS Repair Validator",
  "version": "3.1.1",
  "description": "Real-time repair validation panel for Odoo. Validates warranty coverage, sales orders, part classifications, and workflow tags.",
  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs", "notifications", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.odoo.com/*",
    "https://raw.githubusercontent.com/*",
    "http://10.56.67.23/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.odoo.com/*"
      ],
      "js": ["odoo-rpc.js", "config.js", "validator.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
